# Both AJACE apps on one origin, so the shared session cookie reaches both.
#   /            -> timesheet   (:3009)
#   /procurement -> procurement (:3002, built with basePath=/procurement)
#
# DEFAULT: plain HTTP on :80 for the raw EC2 IP. Pair with COOKIE_SECURE=false
# in both .env.production files, or login cookies won't stick.
:80 {
	encode gzip

	# basePath means the app EXPECTS /procurement in the path — use `handle`,
	# not `handle_path`, so the prefix is preserved rather than stripped.
	handle /procurement* {
		reverse_proxy 127.0.0.1:3002
	}

	handle {
		reverse_proxy 127.0.0.1:3009
	}
}

# LATER, with a domain: comment the block above, uncomment this, set
# COOKIE_SECURE=true in both apps. Caddy issues the certificate automatically.
# {
# 	email admin@ajace.com
# }
# timesheet.ajace.com {
