# ⚠ REFERENCE ONLY — THIS FILE IS NOT INSTALLED ANYWHERE.
#
# The live /etc/caddy/Caddyfile is GENERATED by deploy/scripts/render-caddyfile.sh
# (called by install.sh step [8]) from deploy/site.env. install.sh used to `cp`
# this file over the live config on every deploy, which meant a hand-added HTTPS
# hostname was silently reverted to plain HTTP by the next deploy.
#
#   change the HOSTNAME  ->  deploy/site.env      (or run enable-https.sh)
#   change the ROUTING   ->  deploy/scripts/render-caddyfile.sh
#   apply either         ->  bash deploy/scripts/render-caddyfile.sh
#
# Kept here because it is the clearest statement of what the generator emits in
# the plain-HTTP case. Editing it changes nothing.
#
# Both AJACE apps on one origin, so the shared session cookie reaches both.
#   /            -> timesheet   (:3009)
#   /procurement -> procurement (:3002, built with basePath=/procurement)
#
# Plain HTTP on :80 for the raw EC2 IP. Pair with COOKIE_SECURE=false in both
# .env.production files, or login cookies won't stick.
:80 {
	encode gzip

	# basePath means the app EXPECTS /procurement in the path — use `handle`,
	# not `handle_path`, so the prefix is preserved rather than stripped.
	handle /procurement* {
		reverse_proxy 127.0.0.1:3002
	}

	handle {
		reverse_proxy 127.0.0.1:3009
	}
}

# Moving to a domain + HTTPS? Do NOT hand-edit this file or /etc/caddy/Caddyfile.
# Run the cutover script — it checks DNS first, waits for the certificate to be
# genuinely issued, and only THEN sets COOKIE_SECURE=true (doing that first
# locks every user out of payroll):
#
#   bash deploy/scripts/enable-https.sh apps.yourdomain.com you@yourdomain.com
#
# Runbook: deploy/docs/HTTPS-CUTOVER.md
