# → deploy/site.env   (git-ignored; lives ONLY on the box)
#
# The persisted answer to "what hostname does this box serve?".
#
# WHY THIS FILE EXISTS: install.sh is the deploy path, and step [8] used to copy
# deploy/Caddyfile over /etc/caddy/Caddyfile unconditionally. So editing the
# live Caddyfile by hand worked until the next deploy, which silently put the
# box back on plain HTTP and killed TLS. install.sh now RENDERS the Caddyfile
# from this file instead (deploy/scripts/render-caddyfile.sh), so the hostname
# survives every deploy, and `git pull` cannot clobber it because this file is
# not in git.
#
# You normally do not create this by hand — deploy/scripts/enable-https.sh
# writes it. See deploy/docs/HTTPS-CUTOVER.md.
#
# BEING GIT-IGNORED CUTS BOTH WAYS: `git pull` cannot wipe it, and it does not
# exist on a rebuilt box or a fresh clone. Restoring .env.production from your
# own copy then brings COOKIE_SECURE=true back WITHOUT the hostname — Caddy
# serves plain :80, the cookie demands HTTPS, and nobody can log in to payroll.
# So backup.sh uploads this file nightly to s3://<bucket>/site-config/site.env,
# and install.sh REFUSES to deploy that combination. To recover:
#   aws s3 cp s3://<bucket>/site-config/site.env deploy/site.env

# The public FQDN this box serves. Empty/absent = plain HTTP on :80 (the raw
# EC2 IP), which is the pre-cutover state.
SITE_HOSTNAME=

# Contact address Let's Encrypt uses for expiry warnings. Optional but strongly
# recommended: without it you get no warning if renewal starts failing.
ACME_EMAIL=

# OPTIONAL grace period for old bookmarks and already-sent password-reset
# emails. Set to the box's public IP to keep answering on http://<IP>/ with a
# redirect to https://$SITE_HOSTNAME. Leave empty once nobody needs it.
# Note this only ever redirects; it never serves the app over plain HTTP.
LEGACY_HTTP_HOST=
